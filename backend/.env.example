# Produção (Neon): use o endpoint POOLED (-pooler) com pgbouncer e connect_timeout alto:
# DATABASE_URL="postgresql://user:pass@ep-xxx-pooler.sa-east-1.aws.neon.tech/db?sslmode=require&pgbouncer=true&connection_limit=1&connect_timeout=15"
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/aura"
# DIRECT_URL: endpoint DIRETO (sem -pooler) — usado pelas migrations. Em dev = DATABASE_URL.
# Produção (Neon): DIRECT_URL="postgresql://user:pass@ep-xxx.sa-east-1.aws.neon.tech/db?sslmode=require"
DIRECT_URL="postgresql://postgres:postgres@localhost:5432/aura"
JWT_SECRET="your-jwt-secret-here"
PORT=3333
CORS_ORIGIN="http://localhost:5173,http://localhost:5174"
AWS_ACCESS_KEY_ID="your-access-key-id"
AWS_SECRET_ACCESS_KEY="your-secret-access-key"
AWS_BUCKET_NAME="aura-uploads-development"
AWS_REGION="sa-east-1"

# --- Jobs agendados (módulo `jobs`) ---
# Chaves de assinatura do QStash (console.upstash.com/qstash). São duas por causa
# da rotação de chaves. Sem elas, POST /api/jobs/:name/run responde 503.
QSTASH_CURRENT_SIGNING_KEY=""
QSTASH_NEXT_SIGNING_KEY=""
# URL pública do backend. Se definida, a assinatura também é validada contra a
# URL de destino (anti-replay). Deixe vazia se der falso negativo atrás do proxy.
JOBS_PUBLIC_URL="https://beetsbr-aura-backend.fly.dev"

# --- Empresa de demonstração (job `demo:reset`) ---
# ATENÇÃO: o job APAGA PERMANENTEMENTE todos os dados desta empresa.
# Ela precisa estar marcada com isDemo=true no banco:
#   npx tsx --env-file=.env scripts/mark-demo-company.ts <id>
DEMO_COMPANY_ID=""
# Opcional: sobrescreve o `name` do perfil. Os demais dados cadastrais da demo
# (CNPJ, e-mail, telefone, endereço, depto) ficam em
# src/modules/jobs/handlers/demo.profile.ts e são RESTAURADOS a cada reset.
DEMO_COMPANY_NAME=""
DEMO_USER_NAME="Usuário Demonstração"
DEMO_USER_EMAIL="demo@aura.com.br"
DEMO_USER_PASSWORD="troque-esta-senha"
# Foto do usuário demo: suba o arquivo no S3 (um caminho fixo, ex.: demo/avatar.png)
# e cole a URL pública aqui. O arquivo é PROTEGIDO contra exclusão — trocar ou
# remover a foto no perfil não o apaga, e o reset o restaura.
DEMO_USER_AVATAR=""